# Database Configuration
DATABASE_URL=sqlite:///./delivery.db

# Routing Provider (osrm, fallback)
ROUTING_PROVIDER=osrm
OSRM_URL=https://router.project-osrm.org
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Optimization Settings
MAX_OPTIMIZATION_TIME=30
GENETIC_POPULATION_SIZE=50
GENETIC_GENERATIONS=80

# Simulation Settings & Telemetry Security
SIMULATION_SPEED=1.0
SIMULATION_API_KEY=dev-telemetry-key-2026

# CORS & Host
# Comma-separated allowed origins. Use "*" only for local development.
CORS_ORIGINS=*
HOST=0.0.0.0
PORT=8000

# Frontend (Vite) - copy these into frontend/.env to change API targets
VITE_API_BASE_URL=http://localhost:8000/api
VITE_WS_BASE_URL=ws://localhost:8000/ws/live
